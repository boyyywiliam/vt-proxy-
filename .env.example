# =====================================================================
# VT Proxy Balancer — Environment Example
# SALIN file ini ke .env dan isi nilainya!
#   cp .env.example .env
# File .env TIDAK di-commit ke GitHub (ada di .gitignore).
# File ini (.env.example) AMAN untuk di-commit.
# =====================================================================

# ===== DATABASE =====
# Pilih backend: sqlite | mysql | mariadb
DB_BACKEND=sqlite

# SQLite (default untuk single-server deployment)
SQLITE_URL=sqlite:///./vt_proxy.db

# MySQL/MariaDB (uncomment jika DB_BACKEND=mysql)
# MYSQL_URL=mysql+pymysql://user:password@localhost:3306/vt_proxy

# ===== KEAMANAN =====
# Ganti dengan string acak 64 karakter — generate dengan:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GANTI_DENGAN_SECRET_KEY_YANG_KUAT

# ===== VIRUSTOTAL =====
VT_API_BASE_URL=https://www.virustotal.com/api/v3

# Auto refresh interval (hari) sebelum quota dipakai ulang
AUTO_REFRESH_INTERVAL_DAYS=3

# ===== LOGGING =====
# Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ===== MULTI-SOURCE THREAT INTELLIGENCE =====
# URL base API — biasanya tidak perlu diubah
ABUSEIPDB_API_BASE_URL=https://api.abuseipdb.com/api/v2
URLHAUS_API_BASE_URL=https://urlhaus-api.abuse.ch/v1
MXTOOLBOX_API_BASE_URL=https://mxtoolbox.com/api/v1

# Window laporan AbuseIPDB (hari)
ABUSEIPDB_MAX_AGE_DAYS=90

# Lookup default MxToolbox: blacklist | mx | spf | dmarc
MXTOOLBOX_COMMAND=blacklist

# Timeout HTTP per request (detik)
HTTP_TIMEOUT_SECONDS=15
